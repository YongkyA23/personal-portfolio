# Copy to .env (never commit it) or set these in the systemd unit.

# MySQL connection. Without it the site still runs, with the bundled content and no saving.
DATABASE_URL=mysql://portfolio:change-me@127.0.0.1:3306/portfolio

# Sign-in for /admin. Store only the hash of the password, made with:
#   echo 'your password' | node server/auth.js
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Port the Node server listens on (Nginx proxies to it).
PORT=8787

# Number of proxies in front of the server. 1 when it sits behind Nginx,
# so rate limits see the visitor's address and not Nginx's.
TRUST_PROXY=1
